# Required: create a NEW long-lived access token in the Home Assistant profile.
HA_TOKEN=replace_with_a_new_long_lived_access_token

# Optional: leave blank to generate an MCP API key on first startup.
HA_AGENT_KEY=

# URL remote MCP clients use to reach this server; replace localhost as needed.
MCP_SERVER_URL=http://localhost:8099

# Optional storage overrides. Defaults are ~/home_assistant_config and
# ~/.matterjs-server respectively. Matter data must be writable by UID/GID 1000.
# HA_CONFIG_DIR=/absolute/path/to/home_assistant_config
# MATTER_DATA_DIR=/absolute/path/to/matterjs-server
